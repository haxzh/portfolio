GENERATE_SOURCEMAP=false

# EmailJS Configuration
# 1. Sign up at https://dashboard.emailjs.com/
# 2. Create an Email Service (e.g. Gmail) -> Copy Service ID (e.g. service_xxxxxxx)
# 3. Create an Email Template -> Copy Template ID (e.g. template_xxxxxxx)
# 4. Go to Account > API Keys -> Copy Public Key (e.g. user_xxxxxxx / xxxxxxx)

REACT_APP_EMAILJS_SERVICE_ID=your_service_id_here
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id_here
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key_here
